# GreenDeer local DB credentials.
# Copy this file to local.env and fill in your password.
# local.env is git-ignored and never committed.
# All keys optional; application.yml defaults are:
#   DB_HOST=127.0.0.1  DB_PORT=3306  DB_NAME=greendeer  DB_USER=root  DB_PASSWORD=(empty)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=greendeer
DB_USER=root
DB_PASSWORD=change-me
