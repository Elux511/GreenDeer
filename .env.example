# 前端环境变量（Vite 只把 VITE_ 前缀注入浏览器端，勿放任何密钥）

# 后端 REST 基址（GreenDeer Spring Boot，默认 8080）
VITE_API_BASE_URL=http://127.0.0.1:8080

# 可选：WebSocket 基址。留空则自动由 VITE_API_BASE_URL 推导（http→ws / https→wss）
# 场次实时通道固定为 {WS基址}/ws/live/{sessionId}
# VITE_WS_BASE_URL=ws://127.0.0.1:8080

# 推流/密钥类配置只在后端或 OBS 中设置，不要写进前端
# RTMP_URL=rtmp://127.0.0.1:1935/live/demo
